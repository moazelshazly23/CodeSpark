PROJECT_NAME="Code Spark"
API_V1_STR="/api"

# Security & Tokens
SECRET_KEY=generate_with_openssl_rand_hex_64_characters_here
JWT_SECRET=generate_with_openssl_rand_hex_64_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://codespark_admin:SecureProductionPassword2026@postgres:5432/codespark_db
POSTGRES_SERVER=postgres
POSTGRES_USER=codespark_admin
POSTGRES_PASSWORD=SecureProductionPassword2026
POSTGRES_DB=codespark_db
POSTGRES_PORT=5432

# Storage Configuration
STORAGE_PATH=/storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=100
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CORS
CORS_ORIGINS=["*"]

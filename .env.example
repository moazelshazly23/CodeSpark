# ==============================================================================
# Code Spark — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Cryptography
# Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------------------
CODESPARK_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL in Production or SQLite)
# ------------------------------------------------------------------------------
DATABASE_PATH=backend/codespark_production.db
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/codespark?sslmode=require
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated, no wildcard in production)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://codespark.pages.dev,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=https://codespark.pages.dev

# ------------------------------------------------------------------------------
# 5. Video Storage Configuration
# Providers: 'local' (server disk storage) or 'supabase' (Supabase S3 bucket)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
MAX_VIDEO_UPLOAD_SIZE_MB=50

# Optional Supabase storage credentials (if STORAGE_PROVIDER=supabase)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=codespark-videos

# ------------------------------------------------------------------------------
# 6. SMTP Email Delivery (Transactional & Password Reset OTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@codespark.edu.eg
SMTP_FROM_NAME="CodeSpark Education | منصة كود سبارك"
SMTP_USE_TLS=True
SMTP_USE_SSL=False

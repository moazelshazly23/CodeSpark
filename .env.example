# ==============================================================================
# Code Spark — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Administrative Accounts & Credentials (Optional initial override)
# ------------------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Cryptography
# Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------------------------
CODESPARK_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 4. Database (PostgreSQL in Production or SQLite in Local Dev)
# ------------------------------------------------------------------------------
DATABASE_PATH=backend/codespark_production.db
DATABASE_URL=
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Content & Video Storage Configuration
# Providers: 'local' (server disk storage) or 'supabase' (Supabase S3 bucket)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
MAX_VIDEO_UPLOAD_SIZE_MB=50

# Optional Supabase storage credentials (if STORAGE_PROVIDER=supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# 7. SMTP Email Delivery (Transactional & Password Reset OTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=True
SMTP_USE_SSL=False

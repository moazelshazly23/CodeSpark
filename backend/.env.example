# ===================================================================
# CODE SPARK - Official Environment Configuration Template
# Academic Subject: Programming
# ===================================================================

PROJECT_NAME="Code Spark"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Tokens (Must be a 64-character random string in production)
SECRET_KEY=your_secure_random_production_secret_key_64_chars
JWT_SECRET=your_secure_random_production_secret_key_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL for Production, SQLite fallback)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name
POSTGRES_SERVER=postgres
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=codespark_db
POSTGRES_PORT=5432

# Storage Configuration
STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=100

# Code Execution Sandboxes (Optional overrides)
PYTHON_EXECUTABLE=
NODE_EXECUTABLE=

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Official Payment & Subscription Info (Defaults stored in database platform_settings)
OFFICIAL_CONTACT_PHONE="+201559159038"
INSTAPAY_PHONE="+20159159038"
INSTAPAY_LINK="https://ipn.eg/S/moazasem/instapay/27DsGj"

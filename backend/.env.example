# ==============================================================================
# Code Spark - Application Environment Configuration Template
# COPY THIS FILE TO .env AND SET YOUR LOCAL VALUES.
# NEVER COMMIT SENSITIVE SECRETS OR REAL PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Meta
PROJECT_NAME="Code Spark"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Tokens
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///codespark.db"
DB_PATH="codespark.db"

# Storage Settings
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_MB=100

# AI Coding Assistant (Optional - Gemini or OpenAI API Key)
AI_API_KEY="your-gemini-or-openai-api-key-here"

# Official Payment & Activation Contact Info
OFFICIAL_CONTACT_PHONE="+201559159038"
INSTAPAY_PHONE="+201552696208"
INSTAPAY_LINK="https://ipn.eg/S/moazasem/instapay/27DsGj"

    "db:seed": "python3 -c 'from backend.app.seed_data import seed_database; seed_database(force_refresh=True)'"
  },
  "keywords": [
    "education",
    "programming",
    "high-school",
    "python",
    "fastapi",
    "sqlite",
    "postgresql",
    "arabic-rtl",
    "codespark"
  ],

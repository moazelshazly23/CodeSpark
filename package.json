{
  "name": "code-spark-educational-platform",
  "version": "2.0.0",
  "description": "Code Spark - Complete Secondary School Programming Educational Platform (Real Backend + SQLite/PostgreSQL Database Integration)",
  "main": "backend/run_server.py",
  "scripts": {
    "start": "python3 backend/run_server.py",
    "dev": "python3 backend/run_server.py",
    "test": "python3 backend/test_acceptance_suite.py",
